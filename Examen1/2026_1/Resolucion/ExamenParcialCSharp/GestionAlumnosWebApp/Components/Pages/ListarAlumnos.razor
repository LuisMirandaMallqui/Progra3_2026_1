
@page "/alumnos"


@inject GestionAlumnosBusiness.Alumnos.BOI.IAlumnoBO AlumnoBO


@rendermode InteractiveServer

@* =====================================================================
   <PageTitle> — TITULO DE LA PESTAÑA DEL NAVEGADOR
   =====================================================================
   Cambia el texto que aparece en la pestaña del navegador.
   Es un componente especial de Blazor que modifica el <title> del HTML.
   ===================================================================== *@
<PageTitle>Alumnos</PageTitle>

@* =====================================================================
   ESTRUCTURA HTML — LAYOUT PRINCIPAL
   =====================================================================
   BOOTSTRAP GRID SYSTEM (sistema de grilla):
     - "container mt-4" → contenedor centrado con margen superior
       · container: centra el contenido y limita el ancho máximo
       · mt-4: margin-top de 1.5rem (Bootstrap usa escala 0-5)
         mt-1=0.25rem, mt-2=0.5rem, mt-3=1rem, mt-4=1.5rem, mt-5=3rem
     - "row mb-3 align-items-center" → fila con items centrados verticalmente
       · row: crea una fila del grid (usa flexbox internamente)
       · mb-3: margin-bottom de 1rem
       · align-items-center: centra verticalmente los elementos
     - "col" → columna que ocupa el espacio restante
     - "col-auto" → columna que se ajusta al tamaño de su contenido
   ===================================================================== *@
<div class="container mt-4">

    @* --- ENCABEZADO: Título + Botón de acción --- *@
    @* row + col: divide el encabezado en 2 columnas
       col → el título ocupa todo el espacio disponible
       col-auto → el botón solo ocupa lo que necesita *@
    <div class="row mb-3 align-items-center">
        <div class="col">
            @* FONT AWESOME ICON:
               <i class="fa-solid fa-users"></i>
               · <i> es la etiqueta estándar para íconos
               · "fa-solid" = estilo sólido (relleno)
               · "fa-users" = ícono de grupo de personas
               Para buscar más: https://fontawesome.com/icons *@
            <h2 class="mb-0">
                <i class="fa-solid fa-users"></i> Lista de Alumnos
            </h2>
        </div>
    </div>

    @* =====================================================================
       CARD — COMPONENTE BOOTSTRAP PARA AGRUPAR CONTENIDO
       =====================================================================
       Es como una "tarjeta" con borde, sombra y secciones.
       Estructura:
         <div class="card">           → contenedor principal
           <div class="card-header">  → encabezado (gris claro por defecto)
           <div class="card-body">    → cuerpo principal
           <div class="card-footer">  → pie (opcional)
         </div>

       CLASES USADAS AQUÍ:
         · shadow-sm: agrega una sombra suave (small shadow)
         · bg-white: fondo blanco en el header
         · py-3: padding vertical (arriba y abajo) de 1rem
         · p-0: padding 0 en el body (para que la tabla llegue al borde)
       ===================================================================== *@
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <span class="text-muted">
                @* =====================================================================
                   RENDERIZADO CONDICIONAL CON @if
                   =====================================================================
                   Blazor evalúa estas condiciones en el servidor.
                   Cuando las variables cambian, Blazor re-renderiza
                   automáticamente SOLO las partes que cambiaron.

                   - alumnos == null → OnInitializedAsync aún no terminó
                   - alumnos != null → ya se cargaron, mostramos el total
                   ===================================================================== *@
                @if (alumnos != null)
                {
                    <i class="fa-solid fa-database"></i>
                    @* @alumnos.Count → INTERPOLACION DE C# EN HTML
                       El @ antes de una variable C# inserta su valor en el HTML.
                       Es como un System.out.println pero directo en la página. *@
                    <span> Total: <strong>@alumnos.Count</strong> alumnos registrados</span>
                }
            </span>
        </div>

        @* --- CUERPO DE LA CARD: contiene la tabla --- *@
        @* p-0: sin padding para que la tabla ocupe todo el ancho de la card *@
        <div class="card-body p-0">

            @* =====================================================================
               TABLE-RESPONSIVE — TABLA QUE SE ADAPTA AL ANCHO
               =====================================================================
               "table-responsive" → si la tabla es más ancha que la pantalla,
               agrega scroll horizontal en vez de romper el layout.
               MUY IMPORTANTE en dispositivos móviles.
               ===================================================================== *@
            <div class="table-responsive">

                @* =====================================================================
                   TABLA BOOTSTRAP
                   =====================================================================
                   CLASES DE TABLA:
                     · table: estilo base de Bootstrap (bordes, padding en celdas)
                     · table-hover: las filas cambian de color al pasar el mouse
                     · table-striped: filas alternas tienen fondo gris claro (zebra)
                     · mb-0: sin margin-bottom (para que no haya espacio extra)

                   THEAD (encabezado):
                     · table-dark: fondo oscuro con texto blanco
                     · scope="col": accesibilidad, indica que es encabezado de columna
                     · px-4 py-3: padding horizontal 1.5rem, vertical 1rem

                   TBODY (cuerpo):
                     · align-middle: centra verticalmente el texto en la celda
                     · fw-bold: font-weight bold (texto en negrita)
                   ===================================================================== *@
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="px-4 py-3">ID</th>
                            <th scope="col" class="px-4 py-3">Codigo</th>
                            <th scope="col" class="px-4 py-3">Nombre</th>
                            <th scope="col" class="px-4 py-3">Correo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* =====================================================================
                           ESTADOS DE LA TABLA: null / vacío / con datos
                           =====================================================================
                           Siempre manejar 3 estados:
                           1. null → datos aún cargando → mostrar SPINNER
                           2. vacío → datos cargados pero lista vacía → mensaje
                           3. con datos → mostrar las filas con @foreach
                           ===================================================================== *@
                        @if (alumnos == null)
                        {
                            @* --- ESTADO 1: CARGANDO (spinner de Bootstrap) ---
                               spinner-border: crea un círculo giratorio animado con CSS
                               text-primary: color azul (primary de Bootstrap)
                               visually-hidden: texto oculto visualmente pero leído por lectores de pantalla
                               colspan="4": la celda ocupa las 4 columnas de la tabla *@
                            <tr>
                                <td colspan="4" class="text-center p-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Cargando...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (alumnos.Count == 0)
                        {
                            @* --- ESTADO 2: SIN DATOS --- *@
                            <tr>
                                <td colspan="4" class="text-center text-muted p-4">
                                    <i class="fa-solid fa-inbox"></i> No hay alumnos registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @* --- ESTADO 3: MOSTRAR DATOS ---
                               @foreach: itera la lista C# y genera HTML por cada elemento.
                               Blazor ejecuta esto en el servidor y envía el HTML resultante. *@
                            @foreach (var alumno in alumnos)
                            {
                                <tr>
                                    @* fw-bold: font-weight bold (negrita) para resaltar el ID *@
                                    <td class="align-middle px-4 fw-bold">@alumno.Id</td>

                                    @* BADGE BOOTSTRAP:
                                       <span class="badge bg-primary"> crea una etiqueta/pastilla
                                       con fondo de color y texto blanco.
                                       Colores: bg-primary (azul), bg-success (verde),
                                       bg-danger (rojo), bg-warning (amarillo),
                                       bg-info (celeste), bg-secondary (gris) *@
                                    <td class="align-middle px-4">
                                        <span class="badge bg-primary">@alumno.Codigo</span>
                                    </td>

                                    <td class="align-middle px-4">@alumno.Nombre</td>

                                    @* text-muted: color gris suave para datos secundarios *@
                                    <td class="align-middle px-4 text-muted">
                                        <i class="fa-solid fa-envelope"></i> @alumno.Correo
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* =====================================================================
   BLOQUE @code — LOGICA C# DEL COMPONENTE
   =====================================================================
   Todo lo que está dentro de @code { } es código C# puro.
   Las variables aquí definidas están disponibles en el HTML de arriba.
   Cuando una variable cambia, Blazor re-renderiza automáticamente. *@
@code {
    // Variable de estado: la lista de alumnos
    // El '?' indica que es NULLABLE (puede ser null)
    // null = aún no se cargó, vacía = se cargó pero no hay datos
    private List<GestionAluModel.Alumno.Alumno>? alumnos;

    // ===================================================================
    // OnInitializedAsync() — CICLO DE VIDA DEL COMPONENTE
    // ===================================================================
    // Se ejecuta automáticamente UNA VEZ cuando la página se carga.
    // Es como el Page_Load de ASP.NET WebForms o ngOnInit de Angular.
    //
    // FLUJO INTERNO:
    //   AlumnoBO.ListarTodos()           ← interfaz inyectada con @inject
    //   → AlumnoBOImpl.ListarTodos()     ← implementación registrada en DI
    //   → AlumnoImpl.ListarTodos()       ← capa persistencia (DAO)
    //   → DBManager.EjecutarProcLectura  ← ejecuta el SP en MySQL
    //   → SP: listar_alumnos()           ← stored procedure en la BD
    //   → DataReader → List<Alumno>      ← mapeo de filas a objetos
    // ===================================================================
    protected override async Task OnInitializedAsync()
    {
        alumnos = AlumnoBO.ListarTodos();
    }
}
