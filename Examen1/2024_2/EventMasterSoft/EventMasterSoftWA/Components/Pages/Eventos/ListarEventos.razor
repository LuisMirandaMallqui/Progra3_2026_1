@page "/ListarEventos"

@using EventMasterSoftBusiness.GestEvento.BOI
@using EventMasterSoftModel.Evento

@inject NavigationManager Navigation
@inject IEventoBO eventoBO

<h3 class="mb-4">
    <i class="fa-solid fa-list me-2"></i>
    Listar Eventos
</h3>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-3">Cargando eventos...</div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="d-flex gap-2 mb-3">

                <input type="text" class="form-control"
                       placeholder="Buscar por nombre..."
                       @bind="nombreBusqueda"
                       @bind:event="oninput" />

                <button class="btn btn-primary" @onclick="Buscar">
                    <i class="fa-solid fa-magnifying-glass me-2"></i>
                    Buscar
                </button>

                <button class="btn btn-success" @onclick="RegistrarEvento">
                    <i class="fa-solid fa-plus me-2"></i>
                    Registrar Evento
                </button>

            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger">@mensajeError</div>
            }

            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre del Evento</th>
                        <th>Productora</th>
                        <th>Fecha de Realización</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!eventosFiltrados.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No se encontraron eventos.
                            </td>
                        </tr>
                    }
                    @foreach (var e in eventosFiltrados)
                    {
                        <tr>
                            <td>@e.IdEvento</td>
                            <td>@e.Nombre</td>
                            <td>@e.Productora?.Nombre</td>
                            <td>@e.FechaRealizacion.ToString("dd-MM-yyyy")</td>
                            <td>
                                <button class="btn btn-info btn-sm"
                                        @onclick="() => VisualizarEvento(e.IdEvento)">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
}

@code {

    // Lista completa de eventos traída desde la capa de negocio
    private List<Evento> eventos = new();
    // Lista que se muestra en la tabla, puede estar filtrada
    private List<Evento> eventosFiltrados = new();
    // Texto de búsqueda usado para filtrar por nombre
    private string nombreBusqueda = "";
    // Mensaje de error para mostrar al usuario
    private string mensajeError = "";
    // Indicador de carga para mostrar spinner
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            // Cargar la lista de eventos al iniciar el componente
            eventos = await Task.Run(() => eventoBO.ListarTodos());
            // Inicializar la vista con todos los eventos
            eventosFiltrados = eventos;
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        cargando = false;
    }

    private void Buscar()
    {
        // Filtra la lista en memoria usando el texto de búsqueda
        if (string.IsNullOrWhiteSpace(nombreBusqueda))
            eventosFiltrados = eventos;
        else
            eventosFiltrados = eventos
                .Where(e => e.Nombre != null &&
                            e.Nombre.Contains(nombreBusqueda, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private void RegistrarEvento()
    {
        // Navega al componente de registro/creación de evento
        Navigation.NavigateTo("/RegistrarEvento");
    }

    private void VisualizarEvento(int idEvento)
    {
        // Navega al componente de visualización pasando el id por la ruta
        Navigation.NavigateTo($"/VisualizarEvento/{idEvento}");
    }

}
