@page "/RegistrarEvento"
@page "/VisualizarEvento/{idEvento:int}"

@using EventMasterSoftBusiness.GestEvento.BOI
@using EventMasterSoftBusiness.GestProductora.BOI
@using EventMasterSoftModel.Evento
@using EventMasterSoftModel.GestionProductora

@inject NavigationManager Navigation
@inject IEventoBO eventoBO
@inject IProductoraBO productoraBO
@inject IJSRuntime JS
@* @inject ServicioNotificacion servicioNotificacion *@

<h3 class="mb-4">
    <i class="@IconoTitulo me-2"></i>
    @TituloPagina
</h3>

@if (cargando)
{
    <div class="text-center p-5">

        <div class="spinner-border text-primary"
             role="status">
        </div>

        <div class="mt-3">
            @(EsVisualizacion
                ? "Cargando datos del evento..."
                : "Cargando datos para el registro...")
        </div>

    </div>
}
else
{
    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (EsVisualizacion)
            {
                <div class="mb-3" style="max-width: 180px;">

                    <label class="form-label fw-bold">
                        ID:
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@evento.IdEvento"
                           disabled />

                </div>
            }

            <div class="row">

                @* {{!-- Columna izquierda: Banner --}} *@
                <div class="col-md-6">

                    <label class="form-label fw-bold">Banner Promocional:</label>

                    @if (bannerBase64 != null)
                    {
                        <img src="data:image/jpeg;base64,@bannerBase64"
                             class="img-fluid img-thumbnail d-block mb-2"
                             style="max-height:235px; width:100%;" />
                    }
                    else
                    {
                        <img src="/Images/placeholder.jpg"
                             class="img-fluid img-thumbnail d-block mb-2"
                             style="max-height:235px; width:100%;" />
                    }

                    <input type="file" class="form-control mb-2"
                           @ref="inputFileRef"
                           @onchange="CargarImagen"
                           disabled="@EsVisualizacion" />

                </div>

                @* {{!-- Columna derecha: datos del evento --}} *@
                <div class="col-md-6">

                    @if (EsVisualizacion)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">ID del Evento:</label>
                            <input type="text" class="form-control"
                                   value="@evento.IdEvento" disabled />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Evento:</label>
                        <input type="text" class="form-control"
                               @bind="evento.Nombre"
                               disabled="@EsVisualizacion" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Productora:</label>
                        <select class="form-select"
                                @bind="idProductoraSeleccionada"
                                disabled="@EsVisualizacion">
                            <option value="0">Seleccione una productora</option>
                            @foreach (var p in productoras)
                            {
                                <option value="@p.IdProductora">@p.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo Evento:</label>
                        <div class="form-control">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio"
                                       name="tipoEvento" value="OBRA_TEATRAL"
                                       @onchange="SeleccionarTipoEvento"
                                       checked="@(tipoEventoStr == "OBRA_TEATRAL")"
                                       disabled="@EsVisualizacion" />
                                <label class="form-check-label">OBRA TEATRAL</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio"
                                       name="tipoEvento" value="CONCIERTO"
                                       @onchange="SeleccionarTipoEvento"
                                       checked="@(tipoEventoStr == "CONCIERTO")"
                                       disabled="@EsVisualizacion" />
                                <label class="form-check-label">CONCIERTO</label>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            @* {{!-- Clasificación --}} *@
            <div class="row mt-2">
                <div class="col-md-12">
                    <label class="form-label fw-bold">Clasificación (Público al cual se encuentra dirigido:):</label>
                    <div class="form-control">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio"
                                   name="clasificacion" value="A"
                                   @onchange="SeleccionarClasificacion"
                                   checked="@(clasificacionStr == "A")"
                                   disabled="@EsVisualizacion" />
                            <label class="form-check-label">ADULTOS</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio"
                                   name="clasificacion" value="J"
                                   @onchange="SeleccionarClasificacion"
                                   checked="@(clasificacionStr == "J")"
                                   disabled="@EsVisualizacion" />
                            <label class="form-check-label">JÓVENES</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio"
                                   name="clasificacion" value="N"
                                   @onchange="SeleccionarClasificacion"
                                   checked="@(clasificacionStr == "N")"
                                   disabled="@EsVisualizacion" />
                            <label class="form-check-label">NIÑOS</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio"
                                   name="clasificacion" value="T"
                                   @onchange="SeleccionarClasificacion"
                                   checked="@(clasificacionStr == "T")"
                                   disabled="@EsVisualizacion" />
                            <label class="form-check-label">TODO PÚBLICO</label>
                        </div>
                    </div>
                </div>
            </div>

            @*  {{!-- Costo y Fecha --}} *@
            <div class="row mt-2">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Costo de Realización (S/.):</label>
                    <input type="number" step="0.01" class="form-control"
                           @bind="evento.CostoRealizacion"
                           disabled="@EsVisualizacion" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Fecha de Realización:</label>
                    <input type="date" class="form-control"
                           @bind="evento.FechaRealizacion"
                           disabled="@EsVisualizacion" />
                </div>
            </div>

            @* {{!-- Permisos --}} *@
            <div class="row mt-2 align-items-center">
                <div class="col-md-auto">
                    <label class="form-label fw-bold">Permisos en el Evento:</label>
                </div>
                <div class="col">
                    <div class="form-control">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox"
                                   @bind="evento.PermiteReingreso"
                                   disabled="@EsVisualizacion" />
                            <label class="form-check-label">REINGRESO</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox"
                                   @bind="evento.PermiteGrabacion"
                                   disabled="@EsVisualizacion" />
                            <label class="form-check-label">GRABACIÓN</label>
                        </div>
                    </div>
                </div>
            </div>

            @* {{!-- Descripción --}} *@
            <div class="row mt-2">
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">Descripcion del Evento:</label>
                    <textarea class="form-control" rows="3"
                              @bind="evento.Descripcion"
                              disabled="@EsVisualizacion"></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger">
                    @mensajeError
                </div>
            }

            <div class="d-flex justify-content-between mt-4">

                <button class="btn btn-secondary"
                        @onclick="Regresar">

                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Regresar

                </button>

                @if (!EsVisualizacion)
                {
                    <button class="btn btn-primary"
                            @onclick="Guardar">

                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Guardar

                    </button>
                }

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public int? idEvento { get; set; }

    // Evento que se muestra o se edita
    private Evento evento = new();

    // Id seleccionado en el <select> de productoras
    private int idProductoraSeleccionada = 0;

    // Mensaje de error para mostrar en la UI
    private string mensajeError = "";

    // Indicador de carga para mostrar spinner
    private bool cargando = true;

    // Referencia al input file en el DOM
    private ElementReference inputFileRef;
    // Lista de productoras para el select
    private List<Productora> productoras = new();
    // Banner en bytes y su versión base64 para mostrar en <img>
    private byte[]? bannerBytes;
    private string? bannerBase64;
    // Valores temporales para controles radio y selección
    private string tipoEventoStr = "";
    private string clasificacionStr = "";

    // Usa la URL para detectar si estamos en modo visualización
    private bool EsVisualizacion =>
        Navigation.Uri.Contains("/VisualizarEvento");

    // Título dinámico según el modo
    private string TituloPagina =>
        EsVisualizacion ? "Visualizar Evento" : "Registrar Evento";

    // Icono dinámico según el modo
    private string IconoTitulo =>
        EsVisualizacion ? "fa-solid fa-eye" : "fa-solid fa-plus";

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            productoras = await Task.Run(() => productoraBO.ListarTodos());

            if (EsVisualizacion)
            {
                evento = await Task.Run(() => eventoBO.buscarPorId(idEvento.Value));

                if (evento.Productora != null)
                    idProductoraSeleccionada = evento.Productora.IdProductora;
                if (evento.TipoEvento != null)
                    tipoEventoStr = evento.TipoEvento.ToString();
                clasificacionStr = evento.Clasificacion.ToString();
                if (evento.BannerPromocional != null)
                    bannerBase64 = Convert.ToBase64String(evento.BannerPromocional);
            }
            else
            {
                evento = new Evento();
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"[OnInit] {ex.GetType().Name}: {ex.Message}";
        }
        cargando = false;
    }

    private void SeleccionarTipoEvento(ChangeEventArgs e)
    {
        // SE LEE: si e.Value?.ToString() devuelve null, usa "" en su lugar"
        tipoEventoStr = e.Value?.ToString() ?? "";
    }

    private void SeleccionarClasificacion(ChangeEventArgs e)
    {
        clasificacionStr = e.Value?.ToString() ?? "";
    }

    private async Task Guardar()
    {
        try
        {
            mensajeError = "";

            evento.Productora = productoras.FirstOrDefault(p => p.IdProductora == idProductoraSeleccionada);
            evento.TipoEvento = Enum.Parse<TipoEvento>(tipoEventoStr);
            evento.Clasificacion = clasificacionStr[0];
            evento.BannerPromocional = bannerBytes;

            await Task.Run(() => eventoBO.Insertar(evento));

            Navigation.NavigateTo("/ListarEventos");
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private void Regresar()
    {
        Navigation.NavigateTo("/ListarEventos");
    }

    // Lo de imagen no creo que venga pero pues para la TA al menos xd
    private async Task CargarImagen(ChangeEventArgs e)
    {
        try
        {
            mensajeError = "";
            var base64 = await JS.InvokeAsync<string>("leerArchivoBase64", inputFileRef);
            if (base64 != null)
            {
                bannerBase64 = base64;
                bannerBytes = Convert.FromBase64String(base64);
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"[CargarImagen] {ex.GetType().Name}: {ex.Message}";
        }
    }
}