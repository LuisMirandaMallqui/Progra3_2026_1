@page "/"

<PageTitle>Inicio</PageTitle>

<section class="hero-pokemon">
    <div>
        <p class="eyebrow">Sistema de gestión</p>
        <h1>Pokemon App</h1>
        <p>
            Administra tus pokemones, registra tipos, filtra información
            y prepara la interfaz para conectarla luego con Jakarta y GlassFish.
        </p>

        <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href="/pokemones">
                Ver pokemones
            </a>

            <a class="btn btn-outline-light btn-lg" href="/crear-pokemon">
                Crear pokemon
            </a>
        </div>
    </div>

    <div class="hero-card">
        <div class="pokeball"></div>
        <h3>Pokédex interna</h3>
        <p>Visualiza, registra y filtra tus pokemones desde una interfaz web.</p>
    </div>
</section>